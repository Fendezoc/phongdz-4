local function CreateToggle(parent, name, defaultState, callback)
    local state = defaultState
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 42)
    Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
    Btn.Text = ""
