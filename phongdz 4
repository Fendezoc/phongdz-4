local function EquipWeapon(weaponType)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if not hum then return end

    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == weaponType or (weaponType == "Melee" and tool.Name ~= "Combat")) then
            hum:EquipTool(tool)
            break
        end
    end
end

-- 2. Fast Attack & Auto Click
local RemoteAttack, RemoteId = nil, nil
for _, folderName in ipairs({"Util", "Common", "Remotes", "Assets", "FX"}) do
    local folder = ReplicatedStorage:FindFirstChild(folderName)
    if folder then
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("RemoteEvent") and child:GetAttribute("Id") then
                RemoteAttack = child
                RemoteId = child:GetAttribute("Id")
                break
            end
        end
    end
    if RemoteAttack then break end
end

local netFolder = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
local regAttack = netFolder and netFolder:FindFirstChild("RE/RegisterAttack")
local regHit = netFolder and netFolder:FindFirstChild("RE/RegisterHit")
local seedRemote = netFolder and netFolder:FindFirstChild("seed")

local cachedSeed = 1
if seedRemote and seedRemote:IsA("RemoteFunction") then
    task.spawn(function()
        while task.wait(5) do
            pcall(function() cachedSeed = seedRemote:InvokeServer() end)
        end
    end)
end

task.spawn(function()
    while true do
        task.wait(getgenv().Config.AttackDelay)
        if not getgenv().Config.FastAttack then continue end

        local character = LocalPlayer.Character
        local myHRP = character and character:FindFirstChild("HumanoidRootPart")
        if not myHRP then continue end

        local tool = character:FindFirstChildOfClass("Tool")
        if not tool then continue end

        local validTargets = {}
        local primaryHead = nil

        local checkFolders = {Workspace:FindFirstChild("Enemies"), Workspace:FindFirstChild("Characters")}
        for _, folder in ipairs(checkFolders) do
            if folder then
                for _, entity in ipairs(folder:GetChildren()) do
                    if entity ~= character then
                        local hrp = entity:FindFirstChild("HumanoidRootPart")
                        local hum = entity:FindFirstChild("Humanoid")
                        local head = entity:FindFirstChild("Head")

                        if hrp and hum and hum.Health > 0 and (hrp.Position - myHRP.Position).Magnitude <= getgenv().Config.AttackRange then
                            table.insert(validTargets, {entity, hrp})
                            if not primaryHead and head then
                                primaryHead = head
                            end
                        end
                    end
                end
            end
        end

        if #validTargets > 0 and primaryHead then
            pcall(function()
                if regAttack then regAttack:FireServer() end
                local curKey = tostring(LocalPlayer.UserId):sub(2, 4) .. tostring(coroutine.running()):sub(11, 15)
                if regHit then regHit:FireServer(primaryHead, validTargets, {}, curKey) end

                if RemoteAttack and RemoteId then
                    local encStr = string.gsub("RE/RegisterHit", ".", function(char)
                        return string.char(bit32.bxor(string.byte(char), math.floor(Workspace:GetServerTimeNow() / 10 % 10) + 1))
                    end)
                    local encId = bit32.bxor(RemoteId + 909090, cachedSeed * 2)
                    local fireRemote = cloneref and cloneref(RemoteAttack) or RemoteAttack
                    fireRemote:FireServer(encStr, encId, primaryHead, validTargets)
                end
            end)
        end
    end
end)

