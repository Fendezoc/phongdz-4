                part.CanCollide = false
            end
        end
        if TargetFarmCFrame then
            hrp.CFrame = TargetFarmCFrame
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end
end)

local function StopTween()
    TargetFarmCFrame = nil
    if CurrentTween then
        pcall(function() CurrentTween:Cancel() end)
        CurrentTween = nil
    end
    local hrp = HRP()
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        local bv = hrp:FindFirstChild("TweenBV")
        if bv then bv:Destroy() end
    end
end

local function TweenTo(targetCFrame)
    TargetFarmCFrame = nil
    local hrp = HRP()
    if not hrp then return end

    if CurrentTween then
        pcall(function() CurrentTween:Cancel() end)
        CurrentTween = nil
    end

    local bv = hrp:FindFirstChild("TweenBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "TweenBV"
        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
    end

    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = getgenv().Config.TweenSpeed or 300
    local duration = dist / speed

    CurrentTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    CurrentTween:Play()

    while (getgenv().Config.AutoFarm or getgenv().Config.AutoFarmMaterial or getgenv().Config.FarmBone or getgenv().Config.FarmCake) and CurrentTween and CurrentTween.PlaybackState == Enum.PlaybackState.Playing do
        task.wait()
    end

    if not (getgenv().Config.AutoFarm or getgenv().Config.AutoFarmMaterial or getgenv().Config.FarmBone or getgenv().Config.FarmCake) then
        StopTween()
    end
end

