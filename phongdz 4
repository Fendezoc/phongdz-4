            local cframeQuest = isSubmerged and CFrameQuestNew or CFrameQuest
            local cframeMon = isSubmerged and CFrameMonNew or CFrameMon

            local questGui = LocalPlayer.PlayerGui.Main.Quest
            if not questGui.Visible then
                TargetFarmCFrame = nil
                if (hrp.Position - cframeQuest.Position).Magnitude > 20 then
                    TweenTo(cframeQuest)
                else
                    StopTween()
                    ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", qName, qLvl)[cite: 1, 2]
                end
            else
                local questTitle = questGui.Container.QuestTitle.Title.Text
                if not string.find(questTitle, targetMonName) then
