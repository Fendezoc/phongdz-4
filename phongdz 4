                                local mobHRP = mob.HumanoidRootPart
                                local mobHum = mob.Humanoid

                                while getgenv().Config.AutoFarm and mob.Parent and mobHum.Health > 0 and questGui.Visible do
                                    AutoHaki()
                                    EquipWeapon(getgenv().Config.SelectWeapon)

                                    local targetPos = mobHRP.Position + Vector3.new(0, 25, 0)
                                    TargetFarmCFrame = CFrame.lookAt(targetPos, mobHRP.Position)

                                    mobHRP.Size = Vector3.new(60, 60, 60)
                                    mobHRP.CanCollide = false
                                    mobHum.WalkSpeed = 0
                                    task.wait(0.05)
                                end
                                TargetFarmCFrame = nil
                                break
                            end
                        end
                    end

                    if not foundMob and cframeMon then
                        TargetFarmCFrame = nil
                        TweenTo(cframeMon)
                    end
                end
            end
        end)
    end
end)

